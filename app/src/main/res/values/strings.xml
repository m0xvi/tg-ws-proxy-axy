    <string name="help_auto_dc_title">Auto / data center addresses</string>
    <string name="help_auto_dc_text">When Cloudflare is enabled, manual DC addresses are not needed: the proxy automatically uses clean Cloudflare Anycast IPs and port 80/443 racing. If Cloudflare is disabled, the connection goes directly to Telegram DCs with SNI fronting.</string>
    <string name="help_cloudflare_text">Routes traffic through WebSocket gateways behind Cloudflare CDN with automatic DPI bypass (TLS ClientHello &amp; HTTP Host fragmentation). Recommended for both 4G/LTE mobile networks and Wi-Fi.</string>
    <string name="help_ws_pool_text">The number of pre-warmed WebSocket connections. A larger pool reduces latency when opening chats and sending/receiving media.</string>
    <string name="help_secret_key_text">A special 16-byte MTProto encryption key. Change it only if someone else got access to your old connection link.</string>
    <string name="help_experimental_text">Opens manual setup for all regular and media data centers: DC1, DC3, DC5, DC203, and their media variants.</string>
    <string name="help_autostart_text">Automatically starts the proxy after device reboot.</string>
    <string name="help_slow_connect_title">Media uploads &amp; downloads</string>
    <string name="help_slow_connect_text">Supports full-duplex streaming of large MTProto packets (photos, screenshots, voice and video messages) over WebSocket on both mobile data and Wi-Fi.</string>
    <string name="understood">Got it</string>
    <string name="hero_description">Universal local MTProto-to-WebSocket proxy with DPI bypass, clean Cloudflare Anycast IPs, and fast media transfers over mobile networks and Wi-Fi.</string>
